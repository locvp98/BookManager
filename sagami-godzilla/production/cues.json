[
  {
    "id": 1,
    "start": 0.4,
    "end": 3.36,
    "text": "ゴジラが海から姿を現す"
  },
  {
    "id": 2,
    "start": 3.66,
    "end": 4.791,
    "text": "その瞬間、"
  },
  {
    "id": 3,
    "start": 5.06,
    "end": 8.521,
    "text": "私たちは巨大な怪獣に目を奪われ、"
  },
  {
    "id": 4,
    "start": 8.7,
    "end": 12.561,
    "text": "海そのものについて考える\nことを忘れてしまいます。"
  },
  {
    "id": 5,
    "start": 13.02,
    "end": 17.362,
    "text": "新作映画ゴジラマイハン0.0が\n公開され、"
  },
  {
    "id": 6,
    "start": 17.46,
    "end": 19.921,
    "text": "再び注目が集まるゴジラ。"
  },
  {
    "id": 7,
    "start": 20.14,
    "end": 20.956,
    "text": "しかし、"
  },
  {
    "id": 8,
    "start": 21.04,
    "end": 22.747,
    "text": "地図を開いてみると、"
  },
  {
    "id": 9,
    "start": 22.88,
    "end": 25.241,
    "text": "一つの疑問が浮かび上がります。"
  },
  {
    "id": 10,
    "start": 25.42,
    "end": 28.738,
    "text": "もしゴジラが相模湾に\n現れたとしたら、"
  },
  {
    "id": 11,
    "start": 28.92,
    "end": 31.402,
    "text": "なぜこの海なのでしょうか？"
  },
  {
    "id": 12,
    "start": 31.58,
    "end": 34.761,
    "text": "相模湾は東京湾のすぐ西側、"
  },
  {
    "id": 13,
    "start": 34.94,
    "end": 37.701,
    "text": "神奈川県の南に広がる海です。"
  },
  {
    "id": 14,
    "start": 37.9,
    "end": 40.457,
    "text": "東には三浦半島、"
  },
  {
    "id": 15,
    "start": 40.58,
    "end": 42.501,
    "text": "西には伊豆半島、"
  },
  {
    "id": 16,
    "start": 42.74,
    "end": 45.236,
    "text": "そして南の沖合には"
  },
  {
    "id": 17,
    "start": 45.32,
    "end": 48.981,
    "text": "火山島として知られる\n伊豆大島があります。"
  },
  {
    "id": 18,
    "start": 49.18,
    "end": 50.673,
    "text": "鎌倉や江の島、"
  },
  {
    "id": 19,
    "start": 50.96,
    "end": 53.831,
    "text": "湘南の海岸を訪れた\nことがある人なら、"
  },
  {
    "id": 20,
    "start": 53.96,
    "end": 56.121,
    "text": "決して遠い場所ではありません。"
  },
  {
    "id": 21,
    "start": 56.44,
    "end": 59.391,
    "text": "夏には海水浴客で賑わい、"
  },
  {
    "id": 22,
    "start": 59.54,
    "end": 62.741,
    "text": "漁船が行き交うごく身近な海です。"
  },
  {
    "id": 23,
    "start": 63.04,
    "end": 66.0,
    "text": "東京の高層ビル群から遠く離れた"
  },
  {
    "id": 24,
    "start": 66.12,
    "end": 69.101,
    "text": "誰も知らない秘境と\nいうわけではありません。"
  },
  {
    "id": 25,
    "start": 69.36,
    "end": 70.956,
    "text": "鎌倉や江の島。"
  },
  {
    "id": 26,
    "start": 71.03999999999999,
    "end": 72.141,
    "text": "ところが、"
  },
  {
    "id": 27,
    "start": 72.32,
    "end": 74.67099999999999,
    "text": "海面の下へ目を向けると、"
  },
  {
    "id": 28,
    "start": 74.88,
    "end": 76.761,
    "text": "景色は一変します。"
  },
  {
    "id": 29,
    "start": 77.16,
    "end": 79.721,
    "text": "海岸から少し離れただけで、"
  },
  {
    "id": 30,
    "start": 79.92,
    "end": 82.121,
    "text": "海底は急に深くなり、"
  },
  {
    "id": 31,
    "start": 82.36,
    "end": 86.581,
    "text": "巨大な谷や斜面が複雑に\n入り組んでいます。"
  },
  {
    "id": 32,
    "start": 86.84,
    "end": 87.616,
    "text": "さらに、"
  },
  {
    "id": 33,
    "start": 87.7,
    "end": 92.416,
    "text": "その沖合には相模トラフと\n呼ばれる地球のプレートが"
  },
  {
    "id": 34,
    "start": 92.5,
    "end": 94.701,
    "text": "沈み込む場所が伸びています。"
  },
  {
    "id": 35,
    "start": 95.03999999999999,
    "end": 96.90100000000001,
    "text": "静かな海の底では、"
  },
  {
    "id": 36,
    "start": 97.02000000000001,
    "end": 101.71600000000001,
    "text": "途方もなく長い時間を\nかけて大地の形を変える"
  },
  {
    "id": 37,
    "start": 101.8,
    "end": 104.261,
    "text": "力が働き続けているのです。"
  },
  {
    "id": 38,
    "start": 104.68,
    "end": 106.62100000000001,
    "text": "ここで大切なのは、"
  },
  {
    "id": 39,
    "start": 106.86,
    "end": 108.436,
    "text": "こうした地形が"
  },
  {
    "id": 40,
    "start": 108.52000000000001,
    "end": 113.12100000000001,
    "text": "ゴジラの出現を説明する\n証拠ではないということです。"
  },
  {
    "id": 41,
    "start": 113.56,
    "end": 116.721,
    "text": "怪獣は映画の中の存在です。"
  },
  {
    "id": 42,
    "start": 117.0,
    "end": 117.93299999999999,
    "text": "それでも、"
  },
  {
    "id": 43,
    "start": 118.12,
    "end": 121.696,
    "text": "相模湾が持つ地理的な\n特徴を知れば、"
  },
  {
    "id": 44,
    "start": 121.78,
    "end": 126.561,
    "text": "この海を舞台に想像を\n広げたくなる理由が見えてきます。"
  },
  {
    "id": 45,
    "start": 126.96,
    "end": 129.39,
    "text": "首都圏のすぐ隣にありながら、"
  },
  {
    "id": 46,
    "start": 129.539,
    "end": 132.77100000000002,
    "text": "深い海と動く大地を抱える場所、"
  },
  {
    "id": 47,
    "start": 132.98,
    "end": 134.201,
    "text": "相模湾は、"
  },
  {
    "id": 48,
    "start": 134.56,
    "end": 138.581,
    "text": "私たちが思う以上に\n特別な海なのです。"
  },
  {
    "id": 49,
    "start": 138.76,
    "end": 139.496,
    "text": "では、"
  },
  {
    "id": 50,
    "start": 139.57999999999998,
    "end": 143.901,
    "text": "その特別さは一体どこから\n生まれたのでしょうか？"
  },
  {
    "id": 51,
    "start": 144.14,
    "end": 145.07999999999998,
    "text": "まずは"
  },
  {
    "id": 52,
    "start": 145.26,
    "end": 147.821,
    "text": "地図の上から確かめて\nいきましょう。"
  },
  {
    "id": 53,
    "start": 148.0,
    "end": 152.621,
    "text": "それでは日本列島を上から\n見下ろしてみましょう。"
  },
  {
    "id": 54,
    "start": 152.96,
    "end": 155.679,
    "text": "東京の南に広がる東京湾。"
  },
  {
    "id": 55,
    "start": 155.8,
    "end": 158.361,
    "text": "その西側へ視線を移すと、"
  },
  {
    "id": 56,
    "start": 158.46,
    "end": 163.561,
    "text": "三浦半島を挟んでもう\n一つの大きな海が現れます。"
  },
  {
    "id": 57,
    "start": 163.76,
    "end": 165.18099999999998,
    "text": "相模湾です。"
  },
  {
    "id": 58,
    "start": 165.62,
    "end": 167.46,
    "text": "北側の海岸には"
  },
  {
    "id": 59,
    "start": 167.66,
    "end": 169.401,
    "text": "鎌倉、藤沢、"
  },
  {
    "id": 60,
    "start": 169.54,
    "end": 170.361,
    "text": "平塚、"
  },
  {
    "id": 61,
    "start": 170.5,
    "end": 172.881,
    "text": "小田原といった街が並びます。"
  },
  {
    "id": 62,
    "start": 173.22,
    "end": 175.221,
    "text": "東には三浦半島、"
  },
  {
    "id": 63,
    "start": 175.54,
    "end": 179.996,
    "text": "西には真鶴半島から伊豆半島へ\n続く陸地、、そして海。"
  },
  {
    "id": 64,
    "start": 180.08,
    "end": 183.861,
    "text": "の向こうには伊豆諸島の\n島々が浮かんでいます。"
  },
  {
    "id": 65,
    "start": 184.2,
    "end": 188.401,
    "text": "晴れた日には海岸から富士山を\n望める場所もあります。"
  },
  {
    "id": 66,
    "start": 188.7,
    "end": 190.06,
    "text": "これだけを見ると、"
  },
  {
    "id": 67,
    "start": 190.16,
    "end": 193.24099999999999,
    "text": "美しい観光地の風景に\nしか見えません。"
  },
  {
    "id": 68,
    "start": 193.5,
    "end": 196.961,
    "text": "北側の海岸線も\n一様ではありません。"
  },
  {
    "id": 69,
    "start": 197.46,
    "end": 200.561,
    "text": "湘南では砂浜が長く続き、"
  },
  {
    "id": 70,
    "start": 200.84,
    "end": 205.52100000000002,
    "text": "相模川や酒匂川が平野を\n横切って海に注ぎます。"
  },
  {
    "id": 71,
    "start": 206.0,
    "end": 209.941,
    "text": "西へ進むと箱根の山地が海に迫り、"
  },
  {
    "id": 72,
    "start": 210.07999999999998,
    "end": 214.921,
    "text": "真鶴半島の周辺では岩の\n多い海岸が目立ちます。"
  },
  {
    "id": 73,
    "start": 215.22,
    "end": 217.323,
    "text": "同じ湾に面していながら、"
  },
  {
    "id": 74,
    "start": 217.46,
    "end": 220.281,
    "text": "風景は少しずつ\n変わっていくのです。"
  },
  {
    "id": 75,
    "start": 220.5,
    "end": 221.75900000000001,
    "text": "この違いは、"
  },
  {
    "id": 76,
    "start": 221.86,
    "end": 226.02,
    "text": "海岸の先に続く\n海底地形を考えるための"
  },
  {
    "id": 77,
    "start": 226.26,
    "end": 228.433,
    "text": "大切な手がかりにもなります。"
  },
  {
    "id": 78,
    "start": 228.74,
    "end": 233.421,
    "text": "相模湾と相模灘は\n同じ海なのでしょうか。"
  },
  {
    "id": 79,
    "start": 233.86,
    "end": 234.74099999999999,
    "text": "実は、"
  },
  {
    "id": 80,
    "start": 234.84,
    "end": 237.401,
    "text": "一般的な地理上の区分では、"
  },
  {
    "id": 81,
    "start": 237.52,
    "end": 243.781,
    "text": "神奈川県の城ヶ島と真鶴半島を\n結ぶ線より北を相模湾、"
  },
  {
    "id": 82,
    "start": 243.92,
    "end": 248.161,
    "text": "その南の広い海域を\n相模灘と呼びます。"
  },
  {
    "id": 83,
    "start": 248.48,
    "end": 253.201,
    "text": "伊豆大島はその相模灘の\n南側に位置する島です。"
  },
  {
    "id": 84,
    "start": 253.36,
    "end": 254.132,
    "text": "つまり、"
  },
  {
    "id": 85,
    "start": 254.32,
    "end": 259.016,
    "text": "相模湾の近くにある島と\n相模湾の中にある島は"
  },
  {
    "id": 86,
    "start": 259.1,
    "end": 261.707,
    "text": "必ずしも同じ意味ではありません。"
  },
  {
    "id": 87,
    "start": 262.02,
    "end": 263.6,
    "text": "地名の境界は"
  },
  {
    "id": 88,
    "start": 263.82,
    "end": 267.401,
    "text": "海面に線が\n引かれているわけではありません。"
  },
  {
    "id": 89,
    "start": 267.66,
    "end": 268.549,
    "text": "しかし、"
  },
  {
    "id": 90,
    "start": 268.68,
    "end": 270.756,
    "text": "場所を正確に知ることは、"
  },
  {
    "id": 91,
    "start": 270.84,
    "end": 272.056,
    "text": "その海で"
  },
  {
    "id": 92,
    "start": 272.14,
    "end": 276.181,
    "text": "何が起きているのかを\n考える第一歩になります。"
  },
  {
    "id": 93,
    "start": 276.36,
    "end": 277.152,
    "text": "さらに、"
  },
  {
    "id": 94,
    "start": 277.3,
    "end": 279.466,
    "text": "地図を立体的にしてみると、"
  },
  {
    "id": 95,
    "start": 279.6,
    "end": 281.741,
    "text": "別の特徴が見えてきます。"
  },
  {
    "id": 96,
    "start": 282.0,
    "end": 284.46,
    "text": "北には丹沢の山々、"
  },
  {
    "id": 97,
    "start": 284.82,
    "end": 287.44100000000003,
    "text": "西には箱根の火山地形。"
  },
  {
    "id": 98,
    "start": 287.78,
    "end": 289.814,
    "text": "山から流れ出した川は、"
  },
  {
    "id": 99,
    "start": 289.94,
    "end": 292.948,
    "text": "土砂や栄養を海へ運びます。"
  },
  {
    "id": 100,
    "start": 293.06,
    "end": 293.923,
    "text": "一方、"
  },
  {
    "id": 101,
    "start": 294.02,
    "end": 298.561,
    "text": "沖合には黒潮につながる\n温かい海水が入り、"
  },
  {
    "id": 102,
    "start": 298.74,
    "end": 302.521,
    "text": "深いところには冷たい\n海水も広がっています。"
  },
  {
    "id": 103,
    "start": 303.039,
    "end": 304.26,
    "text": "山と川、"
  },
  {
    "id": 104,
    "start": 304.44,
    "end": 307.761,
    "text": "暖かな海流と冷たい深層水、"
  },
  {
    "id": 105,
    "start": 307.92,
    "end": 310.016,
    "text": "異なる自然の働きが、"
  },
  {
    "id": 106,
    "start": 310.1,
    "end": 313.901,
    "text": "この比較的狭い海域で\n重なっているのです。"
  },
  {
    "id": 107,
    "start": 314.22,
    "end": 315.027,
    "text": "そして、"
  },
  {
    "id": 108,
    "start": 315.12,
    "end": 316.884,
    "text": "その海の底には、"
  },
  {
    "id": 109,
    "start": 317.0,
    "end": 320.596,
    "text": "地上の地図だけでは決して\n見えてこないもう一つの"
  },
  {
    "id": 110,
    "start": 320.68,
    "end": 322.581,
    "text": "地形が横たわっています。"
  },
  {
    "id": 111,
    "start": 322.84,
    "end": 324.241,
    "text": "次に見るのは、"
  },
  {
    "id": 112,
    "start": 324.46,
    "end": 328.241,
    "text": "海面を取り払った相模湾の姿です。"
  },
  {
    "id": 113,
    "start": 328.52,
    "end": 333.361,
    "text": "もし相模湾の海水をすべて\n取り除くことができたら、"
  },
  {
    "id": 114,
    "start": 333.84000000000003,
    "end": 338.501,
    "text": "私たちの目の前にはどのような\n景色が現れるのでしょうか。"
  },
  {
    "id": 115,
    "start": 338.88,
    "end": 340.501,
    "text": "そこに広がるのは、"
  },
  {
    "id": 116,
    "start": 340.64,
    "end": 343.44100000000003,
    "text": "なだらかな砂の\n平原ではありません。"
  },
  {
    "id": 117,
    "start": 343.72,
    "end": 345.181,
    "text": "切り立った斜面、"
  },
  {
    "id": 118,
    "start": 345.34000000000003,
    "end": 347.097,
    "text": "深く刻まれた谷、"
  },
  {
    "id": 119,
    "start": 347.2,
    "end": 349.701,
    "text": "そして海底から盛り上がる丘。"
  },
  {
    "id": 120,
    "start": 349.96,
    "end": 354.976,
    "text": "まるで巨大な山岳地帯をそのまま\n海の中へ沈めたような地形で。"
  },
  {
    "id": 121,
    "start": 355.06,
    "end": 355.621,
    "text": "す。"
  },
  {
    "id": 122,
    "start": 356.26,
    "end": 357.54,
    "text": "相模湾は"
  },
  {
    "id": 123,
    "start": 357.76,
    "end": 358.77,
    "text": "駿河湾、"
  },
  {
    "id": 124,
    "start": 358.86,
    "end": 360.56,
    "text": "富山湾と並んで"
  },
  {
    "id": 125,
    "start": 360.68,
    "end": 363.881,
    "text": "日本を代表する深い湾の一つです。"
  },
  {
    "id": 126,
    "start": 364.28,
    "end": 366.821,
    "text": "とりわけ小田原沖では、"
  },
  {
    "id": 127,
    "start": 366.92,
    "end": 372.061,
    "text": "岸からそれほど離れない場所で\n水深が千メートルを超えます。"
  },
  {
    "id": 128,
    "start": 372.54,
    "end": 374.13,
    "text": "地上で考えれば、"
  },
  {
    "id": 129,
    "start": 374.24,
    "end": 377.636,
    "text": "海岸のすぐ先に高さ千メートル級の"
  },
  {
    "id": 130,
    "start": 377.72,
    "end": 381.781,
    "text": "山を逆さまにしたような\n落差があるということです。"
  },
  {
    "id": 131,
    "start": 382.22,
    "end": 382.898,
    "text": "では、"
  },
  {
    "id": 132,
    "start": 383.04,
    "end": 387.201,
    "text": "なぜこの海はこんなにも\n急に深くなるのでしょうか？"
  },
  {
    "id": 133,
    "start": 387.72,
    "end": 390.181,
    "text": "海底地形図を見てみましょう。"
  },
  {
    "id": 134,
    "start": 390.58,
    "end": 395.581,
    "text": "湾の東側には比較的浅い\n大陸棚が広がっています。"
  },
  {
    "id": 135,
    "start": 395.76,
    "end": 397.621,
    "text": "しかし、西へ進み、"
  },
  {
    "id": 136,
    "start": 397.76,
    "end": 401.96500000000003,
    "text": "平塚から小田原にかけての\n沖合に目を向けると、"
  },
  {
    "id": 137,
    "start": 402.08,
    "end": 403.861,
    "text": "その棚は狭くなり、"
  },
  {
    "id": 138,
    "start": 404.04,
    "end": 407.181,
    "text": "海底が一気に深みへ\n落ち込んでいきます。"
  },
  {
    "id": 139,
    "start": 407.46,
    "end": 409.072,
    "text": "同じ湾の中でも、"
  },
  {
    "id": 140,
    "start": 409.15999999999997,
    "end": 412.781,
    "text": "海の底の姿は大きく異なるのです。"
  },
  {
    "id": 141,
    "start": 413.06,
    "end": 414.94100000000003,
    "text": "さらに注目したいのが、"
  },
  {
    "id": 142,
    "start": 415.06,
    "end": 418.275,
    "text": "海底に刻まれた無数の谷です。"
  },
  {
    "id": 143,
    "start": 418.4,
    "end": 420.46,
    "text": "平塚沖の海底や"
  },
  {
    "id": 144,
    "start": 420.84,
    "end": 423.801,
    "text": "相模トラフへ向かって伸びる谷筋。"
  },
  {
    "id": 145,
    "start": 424.28,
    "end": 427.456,
    "text": "陸上の川と同じように\n枝分かれしたように"
  },
  {
    "id": 146,
    "start": 427.54,
    "end": 429.161,
    "text": "見える場所もあります。"
  },
  {
    "id": 147,
    "start": 429.44,
    "end": 431.541,
    "text": "こうした谷の形成には、"
  },
  {
    "id": 148,
    "start": 431.78,
    "end": 436.901,
    "text": "長い時間をかけて土砂が\n海底斜面を流れ下る現象や、"
  },
  {
    "id": 149,
    "start": 437.06,
    "end": 439.661,
    "text": "地殻の動きなどが関わっています。"
  },
  {
    "id": 150,
    "start": 439.96,
    "end": 443.921,
    "text": "これらの地形は海面から\n眺めても見えません。"
  },
  {
    "id": 151,
    "start": 444.2,
    "end": 446.814,
    "text": "調査船が音波を海底へ送り、"
  },
  {
    "id": 152,
    "start": 446.9,
    "end": 448.838,
    "text": "その反射を測ることで、"
  },
  {
    "id": 153,
    "start": 448.96,
    "end": 452.176,
    "text": "初めて立体的な姿が\n明らかになります。"
  },
  {
    "id": 154,
    "start": 452.54,
    "end": 456.181,
    "text": "私たちが普段見ている\n青い海の下には、"
  },
  {
    "id": 155,
    "start": 456.65999999999997,
    "end": 461.101,
    "text": "想像以上に複雑な起伏が\n隠されているのです。"
  },
  {
    "id": 156,
    "start": 461.58,
    "end": 462.325,
    "text": "そして、"
  },
  {
    "id": 157,
    "start": 462.7,
    "end": 466.26,
    "text": "湾の中央から沖へ伸びているのが"
  },
  {
    "id": 158,
    "start": 466.46,
    "end": 468.001,
    "text": "相模トラフです。"
  },
  {
    "id": 159,
    "start": 468.44,
    "end": 469.6,
    "text": "トラフとは"
  },
  {
    "id": 160,
    "start": 469.76,
    "end": 473.261,
    "text": "細長く伸びる海底の窪地のこと。"
  },
  {
    "id": 161,
    "start": 473.6,
    "end": 475.701,
    "text": "相模湾の深い部分から、"
  },
  {
    "id": 162,
    "start": 475.82,
    "end": 479.581,
    "text": "伊豆大島と房総半島の間を抜け、"
  },
  {
    "id": 163,
    "start": 479.86,
    "end": 482.321,
    "text": "太平洋側へと続いています。"
  },
  {
    "id": 164,
    "start": 482.62,
    "end": 487.081,
    "text": "その長さは三百キロメートルを\n超えるとされています。"
  },
  {
    "id": 165,
    "start": 487.46,
    "end": 489.1,
    "text": "この海底には"
  },
  {
    "id": 166,
    "start": 489.34,
    "end": 490.476,
    "text": "もう一つ"
  },
  {
    "id": 167,
    "start": 490.56,
    "end": 492.661,
    "text": "興味深いものがあります。"
  },
  {
    "id": 168,
    "start": 492.98,
    "end": 494.76,
    "text": "真鶴海丘や"
  },
  {
    "id": 169,
    "start": 494.96,
    "end": 499.901,
    "text": "相模海丘と呼ばれる\n海の底の高まりです。"
  },
  {
    "id": 170,
    "start": 500.24,
    "end": 503.148,
    "text": "深い谷のそばに丘があり、"
  },
  {
    "id": 171,
    "start": 503.28,
    "end": 506.761,
    "text": "またその先には急な斜面が続く。"
  },
  {
    "id": 172,
    "start": 506.98,
    "end": 510.301,
    "text": "海底は決して単純な\n地形ではありません。"
  },
  {
    "id": 173,
    "start": 510.52,
    "end": 511.376,
    "text": "しかし、"
  },
  {
    "id": 174,
    "start": 511.46,
    "end": 513.361,
    "text": "これらの谷や丘は、"
  },
  {
    "id": 175,
    "start": 513.5,
    "end": 517.914,
    "text": "何者かが海底を歩き回った\n痕跡ではありません。"
  },
  {
    "id": 176,
    "start": 518.3,
    "end": 522.505,
    "text": "長い地球の歴史が\n作り上げた自然の地形です。"
  },
  {
    "id": 177,
    "start": 522.88,
    "end": 527.281,
    "text": "長い地球の歴史が\n作り上げた自然の地形です。。"
  },
  {
    "id": 178,
    "start": 527.56,
    "end": 528.293,
    "text": "では、、"
  },
  {
    "id": 179,
    "start": 528.4,
    "end": 531.9,
    "text": "その地形を\n生み出すほど-の巨大な力は"
  },
  {
    "id": 180,
    "start": 532.22,
    "end": 534.101,
    "text": "どこから来るのでしょうか。"
  },
  {
    "id": 181,
    "start": 534.42,
    "end": 536.261,
    "text": "答えを探すためには、"
  },
  {
    "id": 182,
    "start": 536.48,
    "end": 538.841,
    "text": "海底のさらに下へ、"
  },
  {
    "id": 183,
    "start": 539.02,
    "end": 543.001,
    "text": "地球の内部へと視線を\n向ける必要があります。"
  },
  {
    "id": 184,
    "start": 543.26,
    "end": 546.521,
    "text": "海底のさらに下へ目を向けると、"
  },
  {
    "id": 185,
    "start": 546.72,
    "end": 549.821,
    "text": "相模湾の本当の姿が見えてきます。"
  },
  {
    "id": 186,
    "start": 550.1,
    "end": 554.047,
    "text": "ここは二つの巨大な\nプレートが出会う場所です。"
  },
  {
    "id": 187,
    "start": 554.34,
    "end": 557.861,
    "text": "南から移動してきた\nフィリピン海プレートが、"
  },
  {
    "id": 188,
    "start": 558.08,
    "end": 561.8,
    "text": "日本列島のある\n陸側のプレートの下へ"
  },
  {
    "id": 189,
    "start": 561.94,
    "end": 564.101,
    "text": "ゆっくりと沈み込んでいます。"
  },
  {
    "id": 190,
    "start": 564.5,
    "end": 566.06,
    "text": "移動する速さは"
  },
  {
    "id": 191,
    "start": 566.34,
    "end": 568.841,
    "text": "一年間にわずか数センチほど。"
  },
  {
    "id": 192,
    "start": 569.12,
    "end": 572.016,
    "text": "人間の目にはほとんど\n動いていないように"
  },
  {
    "id": 193,
    "start": 572.1,
    "end": 573.281,
    "text": "見えるでしょう。"
  },
  {
    "id": 194,
    "start": 573.58,
    "end": 574.441,
    "text": "しかし、"
  },
  {
    "id": 195,
    "start": 574.58,
    "end": 576.35,
    "text": "地球にとって百年、"
  },
  {
    "id": 196,
    "start": 576.44,
    "end": 578.2,
    "text": "千年という時間は"
  },
  {
    "id": 197,
    "start": 578.38,
    "end": 580.141,
    "text": "決して長くありません。"
  },
  {
    "id": 198,
    "start": 580.38,
    "end": 581.996,
    "text": "プレートの境界は"
  },
  {
    "id": 199,
    "start": 582.08,
    "end": 585.241,
    "text": "いつも滑らかに\n動いているわけではありません。"
  },
  {
    "id": 200,
    "start": 585.4,
    "end": 589.82,
    "text": "互いに強くくっついて\n動きにくくなった場所では、"
  },
  {
    "id": 201,
    "start": 590.2,
    "end": 592.581,
    "text": "地面が少しずつ引きずられ、"
  },
  {
    "id": 202,
    "start": 592.78,
    "end": 594.741,
    "text": "ひずみがたまっていきます。"
  },
  {
    "id": 203,
    "start": 594.84,
    "end": 595.768,
    "text": "そして、"
  },
  {
    "id": 204,
    "start": 596.04,
    "end": 597.727,
    "text": "限界に達した時、"
  },
  {
    "id": 205,
    "start": 597.84,
    "end": 601.441,
    "text": "そのひずみが一気に\n解放されるのです。"
  },
  {
    "id": 206,
    "start": 601.76,
    "end": 602.665,
    "text": "しかも、"
  },
  {
    "id": 207,
    "start": 602.78,
    "end": 607.381,
    "text": "関東の地下は一枚の\nプレートだけで説明できません。"
  },
  {
    "id": 208,
    "start": 607.72,
    "end": 609.441,
    "text": "さらに深い場所では、"
  },
  {
    "id": 209,
    "start": 609.62,
    "end": 612.976,
    "text": "東から太平洋プレートも\n沈み込んでいます。"
  },
  {
    "id": 210,
    "start": 613.06,
    "end": 618.241,
    "text": "異なる方向から入り込む巨大な\n岩盤が重なり合うため、"
  },
  {
    "id": 211,
    "start": 618.38,
    "end": 624.001,
    "text": "この地域の地下構造は日本の\n中でも特に複雑なのです。"
  },
  {
    "id": 212,
    "start": 624.54,
    "end": 630.681,
    "text": "その巨大な力を関東地方の\n人々は実際に経験しています。"
  },
  {
    "id": 213,
    "start": 631.08,
    "end": 636.601,
    "text": "1923年9月1日午前11時58分、"
  },
  {
    "id": 214,
    "start": 636.98,
    "end": 641.101,
    "text": "マグニチュード7.9の\n大正関東地震が発生しました。"
  },
  {
    "id": 215,
    "start": 641.62,
    "end": 644.169,
    "text": "震源は神奈川県西部、"
  },
  {
    "id": 216,
    "start": 644.38,
    "end": 648.021,
    "text": "相模トラフ沿いの\nプレート境界が大きくずれ、"
  },
  {
    "id": 217,
    "start": 648.26,
    "end": 648.976,
    "text": "東京、"
  },
  {
    "id": 218,
    "start": 649.06,
    "end": 650.341,
    "text": "横浜をはじめ、"
  },
  {
    "id": 219,
    "start": 650.58,
    "end": 653.521,
    "text": "広い地域を激しい\n揺れが襲いました。"
  },
  {
    "id": 220,
    "start": 653.919,
    "end": 656.461,
    "text": "建物の倒壊だけではありません。"
  },
  {
    "id": 221,
    "start": 656.72,
    "end": 659.039,
    "text": "地震によって津波が発生し、"
  },
  {
    "id": 222,
    "start": 659.24,
    "end": 661.521,
    "text": "沿岸の町々に押し寄せました。"
  },
  {
    "id": 223,
    "start": 661.64,
    "end": 662.467,
    "text": "そして、"
  },
  {
    "id": 224,
    "start": 662.66,
    "end": 666.261,
    "text": "昼食の準備をしていた\n時間帯と重なったこともあり、"
  },
  {
    "id": 225,
    "start": 666.4,
    "end": 668.621,
    "text": "各地で火災が拡大します。"
  },
  {
    "id": 226,
    "start": 668.9,
    "end": 671.236,
    "text": "地震とその後の災害によって"
  },
  {
    "id": 227,
    "start": 671.32,
    "end": 674.921,
    "text": "十万人を超える人々が命を落とし、"
  },
  {
    "id": 228,
    "start": 675.02,
    "end": 677.301,
    "text": "あるいは行方不明となりました。"
  },
  {
    "id": 229,
    "start": 677.7,
    "end": 678.576,
    "text": "しかも、"
  },
  {
    "id": 230,
    "start": 678.66,
    "end": 681.22,
    "text": "この海域で起きた大地震は"
  },
  {
    "id": 231,
    "start": 681.38,
    "end": 684.621,
    "text": "1923年だけではありません。"
  },
  {
    "id": 232,
    "start": 685.2,
    "end": 689.52,
    "text": "さらに時代を遡ると、1703年にも"
  },
  {
    "id": 233,
    "start": 689.76,
    "end": 692.561,
    "text": "元禄関東地震が発生しています。"
  },
  {
    "id": 234,
    "start": 693.0,
    "end": 699.761,
    "text": "この時も相模湾や房総半島の\n沿岸で強い揺れと津波が起こり、"
  },
  {
    "id": 235,
    "start": 699.98,
    "end": 702.941,
    "text": "海岸の一部では地面が\n隆起しました。。"
  },
  {
    "id": 236,
    "start": 703.38,
    "end": 705.903,
    "text": "海はその底だ-けでなく、"
  },
  {
    "id": 237,
    "start": 706.14,
    "end": 709.401,
    "text": "周囲の陸地の形まで\n変えてしまったのです。"
  },
  {
    "id": 238,
    "start": 709.78,
    "end": 710.681,
    "text": "ただし、"
  },
  {
    "id": 239,
    "start": 710.86,
    "end": 716.141,
    "text": "地震が一定の間隔で必ず\n起きるわけではありません。"
  },
  {
    "id": 240,
    "start": 716.42,
    "end": 720.381,
    "text": "過去の記録は危険を知る\n手がかりになりますが、"
  },
  {
    "id": 241,
    "start": 720.68,
    "end": 725.521,
    "text": "次にいつ揺れるかを正確に\n予言することはできません。"
  },
  {
    "id": 242,
    "start": 725.7,
    "end": 727.601,
    "text": "ここで思い出してください。"
  },
  {
    "id": 243,
    "start": 727.9,
    "end": 731.441,
    "text": "最初に見た相模湾は\n穏やかな海でした。"
  },
  {
    "id": 244,
    "start": 731.64,
    "end": 733.087,
    "text": "そのすぐ下には、"
  },
  {
    "id": 245,
    "start": 733.24,
    "end": 738.541,
    "text": "長い時間をかけて力を溜める\n地球の境界が隠されています。"
  },
  {
    "id": 246,
    "start": 738.9,
    "end": 739.642,
    "text": "では、"
  },
  {
    "id": 247,
    "start": 739.74,
    "end": 745.701,
    "text": "この複雑な地質のすぐ南に\n浮かぶ伊豆大島はどうでしょうか。"
  },
  {
    "id": 248,
    "start": 745.94,
    "end": 752.701,
    "text": "そこには海底の動きと深く関わる\nもう一つの地球の姿があります。"
  },
  {
    "id": 249,
    "start": 753.14,
    "end": 756.101,
    "text": "相模湾から南へ視線を移すと、"
  },
  {
    "id": 250,
    "start": 756.34,
    "end": 759.921,
    "text": "太平洋に一つの大きな\n島が浮かんでいます。"
  },
  {
    "id": 251,
    "start": 760.18,
    "end": 761.6610000000001,
    "text": "伊豆大島です。"
  },
  {
    "id": 252,
    "start": 761.9,
    "end": 765.515,
    "text": "伊豆半島から\nおよそ二十五キロメートル。"
  },
  {
    "id": 253,
    "start": 765.82,
    "end": 768.921,
    "text": "行政上は東京都に属していますが、"
  },
  {
    "id": 254,
    "start": 769.12,
    "end": 773.316,
    "text": "東京の中心部から眺める\n都会の風景とは全く違う"
  },
  {
    "id": 255,
    "start": 773.4,
    "end": 775.121,
    "text": "世界が広がっています。"
  },
  {
    "id": 256,
    "start": 775.3,
    "end": 779.221,
    "text": "この島の正体は一つの\n巨大な火山です。"
  },
  {
    "id": 257,
    "start": 779.7,
    "end": 782.741,
    "text": "私たちが海の上に見ている島は、"
  },
  {
    "id": 258,
    "start": 782.92,
    "end": 786.921,
    "text": "海底から積み重なった火山の\n頂上部分に過ぎません。"
  },
  {
    "id": 259,
    "start": 787.48,
    "end": 791.514,
    "text": "島の最高地点は\n標高七百五十八メートル。"
  },
  {
    "id": 260,
    "start": 791.78,
    "end": 792.596,
    "text": "しかし、"
  },
  {
    "id": 261,
    "start": 792.68,
    "end": 794.661,
    "text": "海面の下まで含めれば、"
  },
  {
    "id": 262,
    "start": 794.78,
    "end": 798.021,
    "text": "火山の姿はさらに大きくなります。"
  },
  {
    "id": 263,
    "start": 798.66,
    "end": 801.401,
    "text": "島の中央にある三原山。"
  },
  {
    "id": 264,
    "start": 801.74,
    "end": 804.24,
    "text": "黒い溶岩に覆われた斜面と"
  },
  {
    "id": 265,
    "start": 804.44,
    "end": 806.741,
    "text": "大きく口を開けた火口が、"
  },
  {
    "id": 266,
    "start": 806.86,
    "end": 809.681,
    "text": "この島の成り立ちを\n物語っています。"
  },
  {
    "id": 267,
    "start": 810.12,
    "end": 811.881,
    "text": "緑の森を抜けると、"
  },
  {
    "id": 268,
    "start": 812.02,
    "end": 816.941,
    "text": "突然黒い火山灰や岩石の\n大地が広がります。"
  },
  {
    "id": 269,
    "start": 817.2,
    "end": 821.001,
    "text": "その光景はまるで\n別の惑星のようです。"
  },
  {
    "id": 270,
    "start": 821.18,
    "end": 824.101,
    "text": "かつて流れ出した\n溶岩は冷え固まり、"
  },
  {
    "id": 271,
    "start": 824.34,
    "end": 826.976,
    "text": "次の噴火が長い時間をかけて"
  },
  {
    "id": 272,
    "start": 827.06,
    "end": 830.441,
    "text": "噴火を繰り返しながら\n形作られてきたのです。"
  },
  {
    "id": 273,
    "start": 830.759,
    "end": 833.456,
    "text": "伊豆大島は長い時間をかけて"
  },
  {
    "id": 274,
    "start": 833.54,
    "end": 836.901,
    "text": "噴火を繰り返しながら\n形作られてきたのです。"
  },
  {
    "id": 275,
    "start": 837.84,
    "end": 838.601,
    "text": "では、"
  },
  {
    "id": 276,
    "start": 838.76,
    "end": 841.801,
    "text": "なぜここに火山が\nあるのでしょうか？"
  },
  {
    "id": 277,
    "start": 842.34,
    "end": 844.896,
    "text": "前に見た相模トラフでは、"
  },
  {
    "id": 278,
    "start": 844.98,
    "end": 846.881,
    "text": "フィリピン海プレートが"
  },
  {
    "id": 279,
    "start": 847.02,
    "end": 850.236,
    "text": "陸側のプレートの下へ\n沈み込んでいました。"
  },
  {
    "id": 280,
    "start": 850.32,
    "end": 851.367,
    "text": "ところが、"
  },
  {
    "id": 281,
    "start": 851.48,
    "end": 854.634,
    "text": "伊豆大島の火山活動を考えるとき、"
  },
  {
    "id": 282,
    "start": 854.94,
    "end": 856.3,
    "text": "重要になるのは"
  },
  {
    "id": 283,
    "start": 856.4,
    "end": 858.021,
    "text": "さらに東側で、"
  },
  {
    "id": 284,
    "start": 858.16,
    "end": 859.696,
    "text": "太平洋プレートが"
  },
  {
    "id": 285,
    "start": 859.78,
    "end": 863.301,
    "text": "フィリピン海プレートの\n下へ沈み込む仕組みです。"
  },
  {
    "id": 286,
    "start": 863.48,
    "end": 867.736,
    "text": "その過程で生じるマグマが\n伊豆諸島に連なる火山を"
  },
  {
    "id": 287,
    "start": 867.82,
    "end": 869.201,
    "text": "育ててきました。"
  },
  {
    "id": 288,
    "start": 869.62,
    "end": 870.701,
    "text": "地図では、"
  },
  {
    "id": 289,
    "start": 870.86,
    "end": 873.24,
    "text": "近くに見える地震の場所と"
  },
  {
    "id": 290,
    "start": 873.34,
    "end": 874.721,
    "text": "火山の場所も、"
  },
  {
    "id": 291,
    "start": 874.82,
    "end": 877.941,
    "text": "地下では異なる仕組みで\n動いているのです。。"
  },
  {
    "id": 292,
    "start": 878.28,
    "end": 879.858,
    "text": "この島の力一を。"
  },
  {
    "id": 293,
    "start": 880.08,
    "end": 882.28,
    "text": "人々が目の当たりにしたのが"
  },
  {
    "id": 294,
    "start": 882.52,
    "end": 885.261,
    "text": "千九百八六年の噴火でした。"
  },
  {
    "id": 295,
    "start": 885.48,
    "end": 887.121,
    "text": "月十五日、"
  },
  {
    "id": 296,
    "start": 887.54,
    "end": 890.221,
    "text": "三原山の火口で噴火が始まり、"
  },
  {
    "id": 297,
    "start": 890.54,
    "end": 892.681,
    "text": "赤い溶岩が噴き上がりました。"
  },
  {
    "id": 298,
    "start": 892.86,
    "end": 898.15,
    "text": "そして二十一日には山の\n斜面に新しい割れ目が生まれ、"
  },
  {
    "id": 299,
    "start": 898.28,
    "end": 900.816,
    "text": "そこからも溶岩が流れ出しました。"
  },
  {
    "id": 300,
    "start": 901.2,
    "end": 902.201,
    "text": "島の人々"
  },
  {
    "id": 301,
    "start": 902.52,
    "end": 908.441,
    "text": "およそ一万人が船などで島外へ\n避難する事態となったのです。"
  },
  {
    "id": 302,
    "start": 908.74,
    "end": 909.676,
    "text": "もちろん、"
  },
  {
    "id": 303,
    "start": 909.76,
    "end": 915.541,
    "text": "これは映画の時代より後に\n起きた実際の自然現象です。"
  },
  {
    "id": 304,
    "start": 915.88,
    "end": 916.916,
    "text": "ゴジラと噴火の"
  },
  {
    "id": 305,
    "start": 917.0,
    "end": 921.201,
    "text": "間に科学的な因果関係が\nあるわけではありません。"
  },
  {
    "id": 306,
    "start": 921.34,
    "end": 922.241,
    "text": "しかし、"
  },
  {
    "id": 307,
    "start": 922.42,
    "end": 927.268,
    "text": "静かな海の向こうに海底から\n成長した火山島がある。"
  },
  {
    "id": 308,
    "start": 927.42,
    "end": 929.175,
    "text": "その事実だけでも、"
  },
  {
    "id": 309,
    "start": 929.3,
    "end": 935.241,
    "text": "この一帯が地球の活動を間近に\n感じられる場所だと分かります。"
  },
  {
    "id": 310,
    "start": 935.56,
    "end": 936.288,
    "text": "そして、"
  },
  {
    "id": 311,
    "start": 936.58,
    "end": 938.261,
    "text": "海底の世界には、"
  },
  {
    "id": 312,
    "start": 938.42,
    "end": 940.516,
    "text": "火山や地震とは別の"
  },
  {
    "id": 313,
    "start": 940.6,
    "end": 943.221,
    "text": "もう一つの謎が残されています。"
  },
  {
    "id": 314,
    "start": 943.48,
    "end": 945.301,
    "text": "深い暗闇の中で、"
  },
  {
    "id": 315,
    "start": 945.42,
    "end": 949.121,
    "text": "一体どのような生き物たちが\n暮らしているのでしょうか。"
  },
  {
    "id": 316,
    "start": 949.4,
    "end": 953.921,
    "text": "火山の島から再び相模湾の\n海へ戻ってみましょう。"
  },
  {
    "id": 317,
    "start": 954.02,
    "end": 956.147,
    "text": "今度は海面を通り抜け、"
  },
  {
    "id": 318,
    "start": 956.28,
    "end": 959.1610000000001,
    "text": "光の届かない深さまで\n降りていきます。"
  },
  {
    "id": 319,
    "start": 959.56,
    "end": 961.781,
    "text": "水深が増すにつれて、"
  },
  {
    "id": 320,
    "start": 961.88,
    "end": 964.298,
    "text": "太陽の光は弱くなり、"
  },
  {
    "id": 321,
    "start": 964.46,
    "end": 965.876,
    "text": "やがて周囲は"
  },
  {
    "id": 322,
    "start": 965.96,
    "end": 968.001,
    "text": "暗闇に包まれます。"
  },
  {
    "id": 323,
    "start": 968.4,
    "end": 969.973,
    "text": "水圧は高まり、"
  },
  {
    "id": 324,
    "start": 970.24,
    "end": 972.181,
    "text": "水温も低くなります。"
  },
  {
    "id": 325,
    "start": 972.44,
    "end": 975.781,
    "text": "人間にとっては過酷な環境です。"
  },
  {
    "id": 326,
    "start": 975.98,
    "end": 976.876,
    "text": "しかし、"
  },
  {
    "id": 327,
    "start": 976.96,
    "end": 981.901,
    "text": "この深い海には確かに\n命の営みがあります。"
  },
  {
    "id": 328,
    "start": 982.32,
    "end": 984.221,
    "text": "相模湾の沿岸では、"
  },
  {
    "id": 329,
    "start": 984.34,
    "end": 985.716,
    "text": "ミツクリザメや"
  },
  {
    "id": 330,
    "start": 985.8,
    "end": 986.658,
    "text": "ラブカ、"
  },
  {
    "id": 331,
    "start": 986.8,
    "end": 990.621,
    "text": "メガマウスといった珍しい\nサメが記録されています。"
  },
  {
    "id": 332,
    "start": 990.84,
    "end": 994.181,
    "text": "長く突き出た吻を\n持つミツクリザメ、"
  },
  {
    "id": 333,
    "start": 994.4,
    "end": 998.201,
    "text": "ウナギを思わせる\n細長い体のラブカ、"
  },
  {
    "id": 334,
    "start": 998.4,
    "end": 1000.901,
    "text": "巨大な口を持つメガマウス。"
  },
  {
    "id": 335,
    "start": 1001.2,
    "end": 1002.676,
    "text": "どれも普段"
  },
  {
    "id": 336,
    "start": 1002.76,
    "end": 1007.421,
    "text": "私たちが目にする魚とは\n大きく異なる姿をしています。"
  },
  {
    "id": 337,
    "start": 1007.62,
    "end": 1008.516,
    "text": "けれども、"
  },
  {
    "id": 338,
    "start": 1008.6,
    "end": 1010.83,
    "text": "この海の本当の不思議は、"
  },
  {
    "id": 339,
    "start": 1011.0,
    "end": 1014.101,
    "text": "奇妙な姿を\nした魚だけではありません。"
  },
  {
    "id": 340,
    "start": 1014.36,
    "end": 1017.101,
    "text": "伊豆半島に近い初島の沖、"
  },
  {
    "id": 341,
    "start": 1017.3,
    "end": 1022.056,
    "text": "水深およそ千百メートルから\n千二百メートルの海底。"
  },
  {
    "id": 342,
    "start": 1022.14,
    "end": 1027.081,
    "text": "ここでは白い貝が密集して\n生きる場所が発見されています。"
  },
  {
    "id": 343,
    "start": 1027.38,
    "end": 1029.341,
    "text": "シロウリガイの仲間です。"
  },
  {
    "id": 344,
    "start": 1029.54,
    "end": 1031.676,
    "text": "光が届かない深海で"
  },
  {
    "id": 345,
    "start": 1031.76,
    "end": 1033.921,
    "text": "どうやって\n生きているのでしょうか。"
  },
  {
    "id": 346,
    "start": 1034.54,
    "end": 1037.096,
    "text": "私たちの知る多くの生態系は、"
  },
  {
    "id": 347,
    "start": 1037.18,
    "end": 1039.856,
    "text": "植物や植物プランクトンが"
  },
  {
    "id": 348,
    "start": 1039.94,
    "end": 1044.141,
    "text": "太陽の光を使う光合成を\n出発点としています。"
  },
  {
    "id": 349,
    "start": 1044.36,
    "end": 1045.276,
    "text": "ところが、"
  },
  {
    "id": 350,
    "start": 1045.36,
    "end": 1047.44,
    "text": "この貝たちを支えるのは"
  },
  {
    "id": 351,
    "start": 1047.56,
    "end": 1048.816,
    "text": "光ではなく、"
  },
  {
    "id": 352,
    "start": 1048.9,
    "end": 1051.121,
    "text": "化学反応のエネルギーです。。"
  },
  {
    "id": 353,
    "start": 1051.52,
    "end": 1055.087,
    "text": "海底から染み出すメタンを\n含む流体と。"
  },
  {
    "id": 354,
    "start": 1055.3,
    "end": 1058.06,
    "text": "海底の微生物の働きによって"
  },
  {
    "id": 355,
    "start": 1058.36,
    "end": 1060.161,
    "text": "硫化水素が生まれます。"
  },
  {
    "id": 356,
    "start": 1060.74,
    "end": 1063.127,
    "text": "貝のエラに共生する細菌は、"
  },
  {
    "id": 357,
    "start": 1063.44,
    "end": 1065.66,
    "text": "その硫化水素を利用して"
  },
  {
    "id": 358,
    "start": 1065.82,
    "end": 1068.401,
    "text": "栄養となる有機物を作ります。"
  },
  {
    "id": 359,
    "start": 1068.62,
    "end": 1071.421,
    "text": "これを化学合成と呼びます。"
  },
  {
    "id": 360,
    "start": 1071.78,
    "end": 1072.641,
    "text": "つまり、"
  },
  {
    "id": 361,
    "start": 1072.78,
    "end": 1075.341,
    "text": "太陽の光が届かない場所でも、"
  },
  {
    "id": 362,
    "start": 1075.44,
    "end": 1077.256,
    "text": "地下から供給される物質を"
  },
  {
    "id": 363,
    "start": 1077.34,
    "end": 1081.001,
    "text": "もとに生き物の集まりが\n成り立っているのです。"
  },
  {
    "id": 364,
    "start": 1081.44,
    "end": 1082.788,
    "text": "研究者たちは、"
  },
  {
    "id": 365,
    "start": 1083.12,
    "end": 1084.8,
    "text": "潜水調査船や"
  },
  {
    "id": 366,
    "start": 1084.94,
    "end": 1087.241,
    "text": "海底観測装置を使い、"
  },
  {
    "id": 367,
    "start": 1087.42,
    "end": 1090.281,
    "text": "こうした生態系を調べてきました。"
  },
  {
    "id": 368,
    "start": 1090.64,
    "end": 1092.421,
    "text": "そこに見つかったのは、"
  },
  {
    "id": 369,
    "start": 1092.62,
    "end": 1094.661,
    "text": "海獣の証拠ではなく、"
  },
  {
    "id": 370,
    "start": 1095.12,
    "end": 1097.996,
    "text": "私たちがまだ十分に理解していない"
  },
  {
    "id": 371,
    "start": 1098.08,
    "end": 1100.041,
    "text": "生命の仕組みでした。"
  },
  {
    "id": 372,
    "start": 1100.48,
    "end": 1101.78,
    "text": "相模湾は"
  },
  {
    "id": 373,
    "start": 1101.88,
    "end": 1104.601,
    "text": "地球が動く場所であると同時に、"
  },
  {
    "id": 374,
    "start": 1104.86,
    "end": 1106.316,
    "text": "暗闇の中で"
  },
  {
    "id": 375,
    "start": 1106.4,
    "end": 1108.901,
    "text": "命がつながる場所でもあります。"
  },
  {
    "id": 376,
    "start": 1109.28,
    "end": 1110.033,
    "text": "では、"
  },
  {
    "id": 377,
    "start": 1110.12,
    "end": 1110.971,
    "text": "地震、"
  },
  {
    "id": 378,
    "start": 1111.12,
    "end": 1111.827,
    "text": "火山、"
  },
  {
    "id": 379,
    "start": 1112.02,
    "end": 1113.096,
    "text": "深い谷、"
  },
  {
    "id": 380,
    "start": 1113.2,
    "end": 1116.841,
    "text": "そして未知のように\n見える生物たち。"
  },
  {
    "id": 381,
    "start": 1117.2,
    "end": 1119.736,
    "text": "こうした特徴を重ねた時、"
  },
  {
    "id": 382,
    "start": 1119.9,
    "end": 1121.836,
    "text": "なぜ私たちは"
  },
  {
    "id": 383,
    "start": 1121.92,
    "end": 1126.541,
    "text": "この海にゴジラの姿を\n想像してしまうのでしょうか。"
  },
  {
    "id": 384,
    "start": 1126.9,
    "end": 1130.236,
    "text": "ここまで見てきた相模湾の地形を"
  },
  {
    "id": 385,
    "start": 1130.32,
    "end": 1131.48,
    "text": "もう一度"
  },
  {
    "id": 386,
    "start": 1131.66,
    "end": 1134.181,
    "text": "映画の世界に重ねてみましょう。"
  },
  {
    "id": 387,
    "start": 1134.62,
    "end": 1136.401,
    "text": "深い海底の谷、"
  },
  {
    "id": 388,
    "start": 1136.72,
    "end": 1139.241,
    "text": "大地が動くプレートの境界、"
  },
  {
    "id": 389,
    "start": 1139.54,
    "end": 1141.301,
    "text": "南に浮かぶ火山島、"
  },
  {
    "id": 390,
    "start": 1141.44,
    "end": 1142.38,
    "text": "そして"
  },
  {
    "id": 391,
    "start": 1142.6,
    "end": 1146.844,
    "text": "光の届かない場所に\n広がる生命の世界。"
  },
  {
    "id": 392,
    "start": 1147.12,
    "end": 1149.118,
    "text": "こうした特徴を知ると、"
  },
  {
    "id": 393,
    "start": 1149.34,
    "end": 1154.981,
    "text": "相模湾はただ怪獣が現れるだけの\n海には見えなくなってきます。"
  },
  {
    "id": 394,
    "start": 1155.14,
    "end": 1156.05,
    "text": "しかし、"
  },
  {
    "id": 395,
    "start": 1156.26,
    "end": 1158.836,
    "text": "映画とのつながりを考える上で、"
  },
  {
    "id": 396,
    "start": 1158.92,
    "end": 1161.681,
    "text": "もっと直接的な理由があります。"
  },
  {
    "id": 397,
    "start": 1161.96,
    "end": 1164.14,
    "text": "実は相模湾は"
  },
  {
    "id": 398,
    "start": 1164.4,
    "end": 1168.16,
    "text": "前作ゴジラマイナスイン点ゼロの\n時点で"
  },
  {
    "id": 399,
    "start": 1168.36,
    "end": 1171.301,
    "text": "物語の重要な舞台に\nなっていました。"
  },
  {
    "id": 400,
    "start": 1171.72,
    "end": 1173.381,
    "text": "覚えているでしょうか。"
  },
  {
    "id": 401,
    "start": 1173.56,
    "end": 1177.676,
    "text": "ゴジラを止めるために\n立てられたウミガメ作戦です。"
  },
  {
    "id": 402,
    "start": 1177.8,
    "end": 1182.241,
    "text": "人々はゴジラを相模湾の\n深い海へ誘い込み、"
  },
  {
    "id": 403,
    "start": 1182.38,
    "end": 1184.476,
    "text": "フロンガスの泡を利用して"
  },
  {
    "id": 404,
    "start": 1184.56,
    "end": 1186.536,
    "text": "一気に沈めようとしました。"
  },
  {
    "id": 405,
    "start": 1186.66,
    "end": 1190.721,
    "text": "目標とされた深さは\nおよそ千五百メートル、"
  },
  {
    "id": 406,
    "start": 1190.96,
    "end": 1191.76,
    "text": "さらに"
  },
  {
    "id": 407,
    "start": 1192.04,
    "end": 1193.74,
    "text": "急浮上させることで"
  },
  {
    "id": 408,
    "start": 1193.9,
    "end": 1197.741,
    "text": "水圧の変化を利用する\n計画も用意されていました。"
  },
  {
    "id": 409,
    "start": 1198.06,
    "end": 1199.66,
    "text": "ここで初めて"
  },
  {
    "id": 410,
    "start": 1199.76,
    "end": 1202.901,
    "text": "地理が物語の鍵になります。"
  },
  {
    "id": 411,
    "start": 1203.26,
    "end": 1207.081,
    "text": "なぜ別の海ではなく\n相模湾だったのか。"
  },
  {
    "id": 412,
    "start": 1207.26,
    "end": 1210.431,
    "text": "それは東京から近いだけでなく、"
  },
  {
    "id": 413,
    "start": 1210.6,
    "end": 1215.221,
    "text": "作戦に必要な深い海域が\n存在していたからです。"
  },
  {
    "id": 414,
    "start": 1215.5,
    "end": 1216.424,
    "text": "もちろん、"
  },
  {
    "id": 415,
    "start": 1216.62,
    "end": 1221.501,
    "text": "映画に描かれた方法で巨大な\n怪獣を倒せるかどうかは、"
  },
  {
    "id": 416,
    "start": 1221.64,
    "end": 1225.301,
    "text": "現実の科学とは分けて\n考える必要があります。"
  },
  {
    "id": 417,
    "start": 1225.44,
    "end": 1226.381,
    "text": "しかし、、"
  },
  {
    "id": 418,
    "start": 1226.5,
    "end": 1228.0,
    "text": "脚本の中で"
  },
  {
    "id": 419,
    "start": 1228.18,
    "end": 1229.996,
    "text": "海の深さが意味を持ってい。"
  },
  {
    "id": 420,
    "start": 1230.08,
    "end": 1231.681,
    "text": "たことは確かです。"
  },
  {
    "id": 421,
    "start": 1232.06,
    "end": 1235.481,
    "text": "相模湾は単なる背景ではなく、"
  },
  {
    "id": 422,
    "start": 1235.8,
    "end": 1239.961,
    "text": "登場人物たちが希望を\n託した場所だったのです。"
  },
  {
    "id": 423,
    "start": 1240.1,
    "end": 1240.975,
    "text": "そして、"
  },
  {
    "id": 424,
    "start": 1241.059,
    "end": 1245.027,
    "text": "続編ゴジラマイハム０.０でも、"
  },
  {
    "id": 425,
    "start": 1245.22,
    "end": 1249.201,
    "text": "相模湾が再び物語の\n焦点になります。"
  },
  {
    "id": 426,
    "start": 1249.4,
    "end": 1252.46,
    "text": "一度は怪獣を沈めようとした海から"
  },
  {
    "id": 427,
    "start": 1252.72,
    "end": 1255.081,
    "text": "再び脅威が姿を現す。"
  },
  {
    "id": 428,
    "start": 1255.18,
    "end": 1256.585,
    "text": "この展開には、"
  },
  {
    "id": 429,
    "start": 1256.84,
    "end": 1260.361,
    "text": "前作を覚えている人ほど\n強く引き込まれるでしょう。"
  },
  {
    "id": 430,
    "start": 1260.74,
    "end": 1261.635,
    "text": "ただし、"
  },
  {
    "id": 431,
    "start": 1261.74,
    "end": 1265.121,
    "text": "ここで一つ線を\n引かなければなりません。"
  },
  {
    "id": 432,
    "start": 1265.48,
    "end": 1269.776,
    "text": "相模トラフの地震や\n伊豆大島の火山活動が"
  },
  {
    "id": 433,
    "start": 1269.86,
    "end": 1275.381,
    "text": "ゴジラを目覚めさせた、と科学的に\n説明できるわけではありません。"
  },
  {
    "id": 434,
    "start": 1275.58,
    "end": 1278.02,
    "text": "それは映画の設定と"
  },
  {
    "id": 435,
    "start": 1278.24,
    "end": 1281.936,
    "text": "私たちが現実の\n地図から読み取る事実を"
  },
  {
    "id": 436,
    "start": 1282.02,
    "end": 1283.961,
    "text": "混同することになります。"
  },
  {
    "id": 437,
    "start": 1284.2,
    "end": 1286.261,
    "text": "むしろ注目すべきなのは、"
  },
  {
    "id": 438,
    "start": 1286.44,
    "end": 1291.921,
    "text": "現実の地形が架空の物語に\n説得力を与えているという点です。"
  },
  {
    "id": 439,
    "start": 1292.38,
    "end": 1296.741,
    "text": "穏やかな湘南の海を\n見ているだけではわからない、"
  },
  {
    "id": 440,
    "start": 1296.98,
    "end": 1299.161,
    "text": "千メートルを超える深さ。"
  },
  {
    "id": 441,
    "start": 1299.56,
    "end": 1302.564,
    "text": "その目に見えない\n落差を知った瞬間、"
  },
  {
    "id": 442,
    "start": 1302.66,
    "end": 1304.02,
    "text": "海の向こうに"
  },
  {
    "id": 443,
    "start": 1304.14,
    "end": 1308.701,
    "text": "何かが潜んでいるかもしれない、と\nいう想像が生まれます。"
  },
  {
    "id": 444,
    "start": 1309.0,
    "end": 1310.28,
    "text": "では最後に"
  },
  {
    "id": 445,
    "start": 1310.42,
    "end": 1314.316,
    "text": "地図から見えてきた\n相模湾の姿を一つの"
  },
  {
    "id": 446,
    "start": 1314.4,
    "end": 1317.081,
    "text": "答えとして整理してみましょう。"
  },
  {
    "id": 447,
    "start": 1317.22,
    "end": 1317.851,
    "text": "では、"
  },
  {
    "id": 448,
    "start": 1318.12,
    "end": 1319.926,
    "text": "最初の問いに戻りましょう。"
  },
  {
    "id": 449,
    "start": 1320.1,
    "end": 1323.58,
    "text": "なぜゴジラの物語と相模湾は"
  },
  {
    "id": 450,
    "start": 1323.76,
    "end": 1326.501,
    "text": "これほど強く\n結びつくのでしょうか。"
  },
  {
    "id": 451,
    "start": 1327.02,
    "end": 1329.221,
    "text": "地図の上で見る相模湾は、"
  },
  {
    "id": 452,
    "start": 1329.54,
    "end": 1331.56,
    "text": "東京のすぐ南にある"
  },
  {
    "id": 453,
    "start": 1331.8,
    "end": 1333.601,
    "text": "ごく身近な海です。"
  },
  {
    "id": 454,
    "start": 1333.92,
    "end": 1335.561,
    "text": "湘南の砂浜、"
  },
  {
    "id": 455,
    "start": 1335.7,
    "end": 1337.301,
    "text": "鎌倉の街並み、"
  },
  {
    "id": 456,
    "start": 1337.56,
    "end": 1340.881,
    "text": "水平線の向こうに浮かぶ伊豆大島。"
  },
  {
    "id": 457,
    "start": 1341.08,
    "end": 1346.781,
    "text": "そこには私たちが知る穏やかな\n日本の風景が広がっています。"
  },
  {
    "id": 458,
    "start": 1347.12,
    "end": 1348.029,
    "text": "ところが、"
  },
  {
    "id": 459,
    "start": 1348.18,
    "end": 1350.681,
    "text": "視線を海底へ移した瞬間、"
  },
  {
    "id": 460,
    "start": 1350.78,
    "end": 1353.31,
    "text": "その印象は一変します。"
  },
  {
    "id": 461,
    "start": 1353.56,
    "end": 1355.661,
    "text": "千メートルを超える深さ、"
  },
  {
    "id": 462,
    "start": 1355.919,
    "end": 1358.256,
    "text": "斜面を刻む海底域、"
  },
  {
    "id": 463,
    "start": 1358.34,
    "end": 1362.039,
    "text": "フィリピン海プレートが\n沈み込む相模トラフ、"
  },
  {
    "id": 464,
    "start": 1362.14,
    "end": 1365.216,
    "text": "そしてその南に連なる火山の"
  },
  {
    "id": 465,
    "start": 1365.3,
    "end": 1370.076,
    "text": "島々。\n１９２３年の大正関東地震は、"
  },
  {
    "id": 466,
    "start": 1370.16,
    "end": 1376.561,
    "text": "この海域に潜む地球の力を\n私たちに痛ましい形で示しました。"
  },
  {
    "id": 467,
    "start": 1376.74,
    "end": 1377.537,
    "text": "一方、"
  },
  {
    "id": 468,
    "start": 1377.82,
    "end": 1379.7,
    "text": "初島沖の深海では、"
  },
  {
    "id": 469,
    "start": 1379.82,
    "end": 1383.14,
    "text": "太陽の光に頼らず生きる貝たちが"
  },
  {
    "id": 470,
    "start": 1383.32,
    "end": 1386.201,
    "text": "今も静かに命をつないでいます。"
  },
  {
    "id": 471,
    "start": 1386.48,
    "end": 1387.768,
    "text": "この海には、"
  },
  {
    "id": 472,
    "start": 1387.9,
    "end": 1389.98,
    "text": "破壊につながる力と"
  },
  {
    "id": 473,
    "start": 1390.28,
    "end": 1392.316,
    "text": "生命を支える仕組みが"
  },
  {
    "id": 474,
    "start": 1392.4,
    "end": 1394.721,
    "text": "同時に存在しているのです。"
  },
  {
    "id": 475,
    "start": 1395.12,
    "end": 1398.421,
    "text": "地上からは見えないその対象こそ、"
  },
  {
    "id": 476,
    "start": 1398.74,
    "end": 1401.621,
    "text": "相模湾の\n不思議さなのかもしれません。。"
  },
  {
    "id": 477,
    "start": 1402.0,
    "end": 1404.956,
    "text": "海は静かに見えても\n止まっているわけません。"
  },
  {
    "id": 478,
    "start": 1405.04,
    "end": 1406.281,
    "text": "ではありません。"
  },
  {
    "id": 479,
    "start": 1406.56,
    "end": 1408.001,
    "text": "地球の時間は、"
  },
  {
    "id": 480,
    "start": 1408.4,
    "end": 1412.761,
    "text": "私たちの日常よりもはるかに\nゆっくりと流れています。"
  },
  {
    "id": 481,
    "start": 1412.96,
    "end": 1414.0,
    "text": "毎幕"
  },
  {
    "id": 482,
    "start": 1414.18,
    "end": 1418.921,
    "text": "ゴジラマイナス一条よりもはるかに\nゆっくりと流れています。"
  },
  {
    "id": 483,
    "start": 1419.5,
    "end": 1420.702,
    "text": "だからこそ、"
  },
  {
    "id": 484,
    "start": 1420.94,
    "end": 1423.061,
    "text": "相模湾という地名には、"
  },
  {
    "id": 485,
    "start": 1423.24,
    "end": 1427.741,
    "text": "物語を知る人にとって\n特別な響きがあります。"
  },
  {
    "id": 486,
    "start": 1427.96,
    "end": 1428.921,
    "text": "ただし、"
  },
  {
    "id": 487,
    "start": 1429.12,
    "end": 1432.601,
    "text": "地震が怪獣を\n生み出したわけではありませんし、"
  },
  {
    "id": 488,
    "start": 1432.759,
    "end": 1436.691,
    "text": "海底にゴジラが眠っていると\nいう証拠もありません。"
  },
  {
    "id": 489,
    "start": 1436.8,
    "end": 1442.381,
    "text": "映画の想像力と地理学が明らかに\nした事実は別のものです。"
  },
  {
    "id": 490,
    "start": 1442.52,
    "end": 1443.416,
    "text": "それでも、"
  },
  {
    "id": 491,
    "start": 1443.52,
    "end": 1445.664,
    "text": "現実の地形を知ることで、"
  },
  {
    "id": 492,
    "start": 1445.8,
    "end": 1450.461,
    "text": "物語の舞台は以前よりはるかに\n鮮やかに見えてきます。"
  },
  {
    "id": 493,
    "start": 1450.96,
    "end": 1453.821,
    "text": "次に相模湾を訪れる時は、"
  },
  {
    "id": 494,
    "start": 1454.14,
    "end": 1457.381,
    "text": "ぜひ海面の下を\n想像してみてください。"
  },
  {
    "id": 495,
    "start": 1457.94,
    "end": 1460.581,
    "text": "目の前の青い海の奥には、"
  },
  {
    "id": 496,
    "start": 1460.84,
    "end": 1463.86,
    "text": "長い年月をかけて形作られた"
  },
  {
    "id": 497,
    "start": 1463.96,
    "end": 1466.701,
    "text": "もう一つの日本が広がっています。"
  },
  {
    "id": 498,
    "start": 1467.14,
    "end": 1469.221,
    "text": "地図には描かれていても、"
  },
  {
    "id": 499,
    "start": 1469.62,
    "end": 1471.841,
    "text": "私たちがまだ知らない世界。"
  },
  {
    "id": 500,
    "start": 1472.1,
    "end": 1474.1,
    "text": "その謎をたどる旅は"
  },
  {
    "id": 501,
    "start": 1474.26,
    "end": 1475.761,
    "text": "これからも続きます。"
  }
]
